---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import DiscoverIsland from '../islands/DiscoverIsland';
import QuizIsland from '../islands/QuizIsland';
import SavedIsland from '../islands/SavedIsland';
import LearnIsland from '../islands/LearnIsland';
import DockIsland from '../islands/DockIsland';
import ToastIsland from '../islands/ToastIsland';
---

<Layout title="Find Your Cup — coffee, de-jargonized">
  <div class="phone">
    <div class="statusbar" aria-hidden="true">
      <span>9:41</span>
      <span class="sb-right">
        <svg viewBox="0 0 18 12" width="17" height="12" fill="currentColor"><rect y="7" width="3" height="5" rx="1"/><rect x="5" y="5" width="3" height="7" rx="1"/><rect x="10" y="2.5" width="3" height="9.5" rx="1"/><rect x="15" opacity=".35" width="3" height="12" rx="1"/></svg>
        <svg viewBox="0 0 16 12" width="15" height="12"><path d="M8 10.8l1.9-2.4a3 3 0 0 0-3.8 0L8 10.8z" fill="currentColor"/><path d="M3.4 5.9a6.6 6.6 0 0 1 9.2 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M5.3 8.1a4 4 0 0 1 5.4 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <svg viewBox="0 0 25 12" width="24" height="12" fill="currentColor"><rect x="1" y="1" width="20" height="10" rx="3" fill="none" stroke="currentColor" opacity=".4"/><rect x="2.5" y="2.5" width="14" height="7" rx="1.5"/><path d="M22.5 4v4c1.2-.4 1.2-3.6 0-4z"/></svg>
      </span>
    </div>

    <main id="scroller">
      <!-- DISCOVER: static hero (SSR) + interactive island (deferred now that Quiz is landing) -->
      <section class="screen" id="scr-discover">
        <Hero />
        <DiscoverIsland client:idle />
      </section>

      <!-- QUIZ: landing tab — interactive immediately (`client:load`) -->
      <section class="screen active" id="scr-quiz">
        <header class="page-head">
          <h1>Find your origin</h1>
          <p>5 questions, one honest pick.</p>
        </header>
        <QuizIsland client:load />
      </section>

      <!-- SAVED -->
      <section class="screen" id="scr-saved">
        <header class="page-head">
          <h1>Saved</h1>
          <p>Coffees you liked.</p>
        </header>
        <SavedIsland client:idle />
      </section>

      <!-- LEARN -->
      <section class="screen" id="scr-learn">
        <header class="page-head">
          <h1>Learn</h1>
          <p>Short answers, plain language.</p>
        </header>
        <LearnIsland client:idle />
      </section>
    </main>

    <DockIsland client:load />
    <ToastIsland client:load />
  </div>
</Layout>
